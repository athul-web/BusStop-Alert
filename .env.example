# BusStop Alert - Environment Variables Template
# Copy this file to .env.local and fill in your Supabase project credentials

# Supabase Public API URL & Anon Key (Client-side safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose in NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# MapTiler API Key (Client-side safe) - required for the Journey map's
# MapTiler Streets v4 tile layer. Get a free key at https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-api-key

# Optional: Mapbox Public Token (Only if you prefer Mapbox tiles over the default OpenStreetMap)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.xxx
